    "text": "name: CI\non:\n  push:\n  pull_request:\njobs:\n  verify:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: pnpm/action-setup@v4\n        with:\n          version: 10.18.3\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: pnpm\n      - run: pnpm install --frozen-lockfile\n      - run: pnpm check:content\n      - run: pnpm check:secrets\n      - run: pnpm typecheck\n      - run: pnpm lint\n      - run: pnpm test\n      - run: pnpm benchmark\n      - run: pnpm benchmark:checks\n      - run: pnpm build\n      - run: pnpm audit\n      - run: pnpm exec playwright install --with-deps chromium\n      - run: pnpm e2e --max-failures=1\n      - name: Verify isolated deployed preview\n        if: github.head_ref == 'feat/approved-workbench-integration' || github.head_ref == 'fix/scenario-guidance' || github.head_ref == 'fix/audit-correctness'\n        env:\n          MINSK_STAGING_URL: https://approved-workbench.minsk-web-preview.pages.dev\n          MINSK_API_URL: https://faultline-api-visual-preview.judithorluchee.workers.dev\n          PLAYWRIGHT_HTML_OUTPUT_DIR: playwright-report-public\n          MINSK_EXPECTED_COMMIT: ${{ github.event.pull_request.head.sha }}\n          MINSK_CHECK_PREVIEW_COMMIT: ${{ github.head_ref == 'fix/audit-correctness' }}\n        run: |\n          node --input-type=module -e \"const r=await fetch(process.env.MINSK_API_URL+'/api/v1/budget'); if(!r.ok)throw new Error('Review API unavailable'); const b=await r.json(); if(b.liveModelEnabled||b.openWeightEnabled||b.publicChallengerEnabled||b.configuration?.keyPresent)throw new Error('Review API must have all providers disabled and no provider key'); console.log('Review API provider isolation verified');\"\n          if [ \"$MINSK_CHECK_PREVIEW_COMMIT\" = \"true\" ]; then\n            node --input-type=module -e \"const r=await fetch(process.env.MINSK_STAGING_URL+'/build-info.json'); if(!r.ok)throw new Error('Preview build identity unavailable'); const b=await r.json(); if(b.sourceCommit!==process.env.MINSK_EXPECTED_COMMIT||b.apiOrigin!==process.env.MINSK_API_URL)throw new Error('Preview does not match the tested source and isolated API'); console.log('Deployed source commit verified: '+b.sourceCommit);\"\n          fi\n          pnpm e2e --max-failures=1 --output=test-results-public\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: minsk-browser-evidence\n          path: |\n            test-results/\n            playwright-report/\n            test-results-public/\n            playwright-report-public/\n          if-no-files-found: ignore\n"
  },
  "responseStatus": 200,

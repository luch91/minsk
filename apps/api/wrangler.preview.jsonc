{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "minsk-api-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "MODEL_CALLS_ENABLED": "true",
    "WONDER_ENABLED": "true",
    "BASETEN_CHALLENGER_ENABLED": "true",
    "PUBLIC_CHALLENGER_ENABLED": "true",
    "META_CEILING_MICRO_USD": "49000000",
    "BASETEN_CEILING_MICRO_USD": "10000000",
    "BASETEN_MAX_CALLS_PER_DAY": "50",
    "MINSK_EVAL_MAX_CALLS": "100",
    "MINSK_EVAL_MAX_MICRO_USD": "2000000",
    "PUBLIC_GLOBAL_REQUESTS_PER_MINUTE": "300",
    "PUBLIC_CLIENT_REQUESTS_PER_MINUTE": "30",
    "PUBLIC_GLOBAL_MODEL_CALLS_PER_DAY": "500",
    "PUBLIC_CLIENT_MODEL_CALLS_PER_DAY": "20",
    "ALLOWED_ORIGIN": "https://minsk.pages.dev,https://release-candidate.minsk.pages.dev,https://minsk-web-preview.pages.dev"
  },
  "observability": {"enabled": true, "logs": {"head_sampling_rate": 1}, "traces": {"enabled": true, "head_sampling_rate": 0.05}},
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "BudgetLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetLedger"] }]
}
